<div class="app-shell" data-app-shell>
  <div class="sidebar-backdrop" data-sidebar-close hidden></div>

  <aside class="sidebar" id="app-sidebar" aria-label="Menu học sinh">
    <a href="/student/dashboard" class="sidebar-brand">
      <img class="brand-logo" src="/images/jinmath-logo.png" alt="JinMath" width="120" height="36">
      <span class="brand-text brand-text-role">
        <span>Học sinh</span>
      </span>
    </a>

    <nav class="sidebar-nav">
      <p class="sidebar-section-label">Tổng quan</p>
      <a href="/student/dashboard" class="nav-link" data-nav-prefix="/student/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
        <span>Bảng điều khiển</span>
      </a>

      <p class="sidebar-section-label">Học tập</p>
      <a href="/student/classes" class="nav-link" data-nav-prefix="/student/classes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Lớp học</span>
      </a>
      <a href="/student/exams" class="nav-link" data-nav-prefix="/student/exams">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>Bài thi</span>
      </a>
      <a href="/student/results" class="nav-link" data-nav-prefix="/student/results">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <span>Kết quả</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <strong><%= user ? user.hoTen : '' %></strong>
        <span class="nav-user"><%= user ? user.email : '' %></span>
      </div>
      <form action="/auth/logout" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-sidebar-logout btn-sm">Đăng xuất</button>
      </form>
    </div>
  </aside>

  <div class="app-frame">
    <header class="topbar">
      <div class="topbar-left">
        <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Mở menu" aria-controls="app-sidebar" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-title"><%= typeof title !== 'undefined' && title ? title : 'Bảng điều khiển' %></div>
      </div>
      <div class="topbar-actions">
        <a href="/student/classes/join" class="btn btn-secondary btn-sm">Tham gia lớp</a>
      </div>
    </header>
    <div class="app-content">
