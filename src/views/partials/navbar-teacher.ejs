<div class="app-shell" data-app-shell>
  <div class="sidebar-backdrop" data-sidebar-close hidden></div>

  <aside class="sidebar" id="app-sidebar" aria-label="Menu giáo viên">
    <a href="/teacher/dashboard" class="sidebar-brand">
      <img class="brand-logo" src="/images/jinmath-logo.png" alt="JinMath" width="120" height="36">
      <span class="brand-text brand-text-role">
        <span>Giáo viên</span>
      </span>
    </a>

    <nav class="sidebar-nav">
      <p class="sidebar-section-label">Tổng quan</p>
      <a href="/teacher/dashboard" class="nav-link" data-nav-prefix="/teacher/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
        <span>Bảng điều khiển</span>
      </a>

      <p class="sidebar-section-label">Quản lý</p>
      <a href="/teacher/classes" class="nav-link" data-nav-prefix="/teacher/classes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 0v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Lớp học</span>
      </a>
      <a href="/teacher/accounts" class="nav-link" data-nav-prefix="/teacher/accounts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Tài khoản HS</span>
      </a>
      <a href="/teacher/topics" class="nav-link" data-nav-prefix="/teacher/topics">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <span>Chủ đề</span>
      </a>
      <a href="/teacher/questions" class="nav-link" data-nav-prefix="/teacher/questions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Câu hỏi</span>
      </a>
      <a href="/teacher/exams" class="nav-link" data-nav-prefix="/teacher/exams">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Đề thi</span>
      </a>
      <a href="/teacher/incidents" class="nav-link" data-nav-prefix="/teacher/incidents">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Sự cố</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <strong><%= user ? user.hoTen : '' %></strong>
        <span class="nav-user"><%= user ? user.email : '' %></span>
      </div>
      <form action="/auth/logout" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-sidebar-logout btn-sm">Đăng xuất</button>
      </form>
    </div>
  </aside>

  <div class="app-frame">
    <header class="topbar">
      <div class="topbar-left">
        <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Mở menu" aria-controls="app-sidebar" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-title"><%= typeof title !== 'undefined' && title ? title : 'Bảng điều khiển' %></div>
      </div>
      <div class="topbar-actions">
        <a href="/teacher/exams/create" class="btn btn-primary btn-sm">Tạo đề thi</a>
      </div>
    </header>
    <div class="app-content">
