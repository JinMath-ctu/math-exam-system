<%
  const dtId = typeof id !== 'undefined' ? id : name;
  const dtName = typeof name !== 'undefined' ? name : id;
  const dtValue = typeof value !== 'undefined' && value ? value : '';
  const dtRequired = typeof required !== 'undefined' && required;
  const dtTitle = typeof title !== 'undefined' ? title : 'Ví dụ: 08/08/2026 15:30';
%>
<div class="datetime-vn-wrap">
  <input
    type="text"
    class="datetime-vn"
    id="<%= dtId %>"
    name="<%= dtName %>"
    value="<%= dtValue %>"
    placeholder="dd/mm/yyyy HH:mm"
    inputmode="numeric"
    autocomplete="off"
    <%= dtRequired ? 'required' : '' %>
    pattern="\d{2}/\d{2}/\d{4} \d{2}:\d{2}"
    title="<%= dtTitle %>"
  >
  <span class="datetime-vn-trigger" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M3 10h18"></path>
      <path d="M8 3v4M16 3v4"></path>
    </svg>
  </span>
  <!--
    datetime-local phủ lên nút lịch (opacity 0, vẫn nhận touch).
    Cách này mở được bánh xe ngày/tháng/năm trên iOS/Android; showPicker() thường không ổn trên mobile.
  -->
  <input
    type="datetime-local"
    class="datetime-vn-picker"
    tabindex="-1"
    aria-label="Chọn ngày giờ trên lịch"
  >
</div>
