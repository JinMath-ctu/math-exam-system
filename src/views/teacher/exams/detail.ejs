<%
const statusLabels = { NHAP: 'Nháp', DA_CONG_BO: 'Đã công bố', DA_HUY: 'Đã hủy' };
const statusBadge = { NHAP: 'badge-muted', DA_CONG_BO: 'badge-success', DA_HUY: 'badge-archived' };
const typeLabels = {MOT_DAP_AN:'Một đáp án', DUNG_SAI:'Đúng/Sai', TRA_LOI_NGAN:'Trả lời ngắn', TU_LUAN:'Tự luận'};
%>
<%- include('../../partials/header') %>
<%- include('../../partials/navbar-teacher') %>
<main id="main-content" class="page-list">
  <div class="container">
    <p><a href="/teacher/exams">&larr; Đề thi</a></p>

    <header class="page-header">
      <div class="card-header-row">
        <h1><%= exam.ten_de %></h1>
        <span class="badge <%= statusBadge[exam.trang_thai] %>"><%= statusLabels[exam.trang_thai] %></span>
      </div>
    </header>

    <%- include('../../partials/flash') %>

    <div class="card">
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Thời lượng</span>
          <span class="detail-value"><%= exam.thoi_luong_phut %> phút</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Tổng điểm</span>
          <span class="detail-value"><%= Number(exam.tong_diem).toFixed(2) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Giờ mở đề</span>
          <span class="detail-value"><%= formatDateTimeVN(exam.thoi_gian_bat_dau) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Giờ đóng đề</span>
          <span class="detail-value"><%= formatDateTimeVN(exam.thoi_gian_ket_thuc) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Số lần được làm</span>
          <span class="detail-value"><%= exam.so_lan_duoc_lam %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Số lượt đã làm</span>
          <span class="detail-value"><%= attemptCount %></span>
        </div>
      </div>

      <% if (exam.mo_ta) { %><p><%= exam.mo_ta %></p><% } %>

      <p class="field-hint">
        <%= exam.tron_cau_hoi ? 'Có trộn thứ tự câu hỏi. ' : 'Không trộn thứ tự câu hỏi. ' %>
        <%= exam.cho_xem_dap_an ? 'Cho phép xem đáp án sau khi công bố kết quả.' : 'Không cho xem đáp án.' %>
        <% if (exam.da_cong_bo_ket_qua) { %>Đã công bố kết quả lúc <%= formatDateTimeVN(exam.thoi_gian_cong_bo_ket_qua) %>.<% } %>
      </p>

      <div class="card-actions">
        <% if (isEditable) { %>
          <a href="/teacher/exams/<%= exam.id %>/edit" class="btn btn-secondary">Sửa thông tin</a>
          <form action="/teacher/exams/<%= exam.id %>/publish" method="POST" class="inline-form" data-confirm="Công bố đề thi này? Sau khi công bố sẽ khóa cấu trúc đề.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-primary">Công bố đề</button>
          </form>
        <% } %>
        <% if (exam.trang_thai !== 'NHAP') { %>
          <a href="/teacher/exams/<%= exam.id %>/attempts" class="btn btn-secondary">Lượt làm &amp; chấm bài</a>
          <a href="/teacher/exams/<%= exam.id %>/statistics" class="btn btn-secondary">Thống kê</a>
        <% } %>
        <% if (exam.trang_thai === 'DA_CONG_BO') { %>
          <form action="/teacher/exams/<%= exam.id %>/cancel" method="POST" class="inline-form" data-confirm="Hủy đề đang công bố? Học sinh sẽ không làm thêm được. Bản ghi đề vẫn giữ lại (không xóa dữ liệu).">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger-outline">Hủy công bố</button>
          </form>
        <% } %>
        <% if (exam.trang_thai === 'NHAP' || exam.trang_thai === 'DA_HUY') { %>
          <form
            action="/teacher/exams/<%= exam.id %>/delete"
            method="POST"
            class="inline-form"
            data-confirm="<%= Number(attemptCount) > 0
              ? 'Xóa vĩnh viễn đề này? Mọi lượt làm, điểm và sự cố liên quan cũng bị xóa. Không thể hoàn tác.'
              : 'Xóa vĩnh viễn đề thi này khỏi hệ thống? Không thể hoàn tác.' %>"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Xóa đề</button>
          </form>
        <% } %>
      </div>
      <% if (exam.trang_thai === 'DA_CONG_BO') { %>
        <p class="field-hint">Hủy công bố chỉ dừng đề (đổi sang Đã hủy), không xóa dữ liệu. Muốn xóa hẳn thì hủy công bố trước, rồi bấm Xóa đề.</p>
      <% } %>
    </div>

    <% if (exam.trang_thai === 'DA_CONG_BO' && !exam.da_cong_bo_ket_qua) { %>
      <div class="card">
        <h2 class="section-title" style="margin-top:0">Công bố kết quả cho học sinh</h2>
        <p class="field-hint">
          Điểm đã được chấm trên hệ thống ngay khi nộp (câu khách quan) / sau khi GV chấm tự luận,
          nhưng học sinh chỉ xem được điểm sau khi bạn bấm công bố kết quả bên dưới.
        </p>
        <% if (publishResultsStatus && publishResultsStatus.canPublish) { %>
          <form action="/teacher/exams/<%= exam.id %>/publish-results" method="POST" class="form" data-confirm="Công bố kết quả cho học sinh? Sau khi công bố, học sinh sẽ xem được điểm.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="checkbox-label option-toggle">
              <input type="checkbox" name="choXemDapAn" value="true" <%= exam.cho_xem_dap_an ? 'checked' : '' %>>
              Cho học sinh xem đáp án sau khi công bố
            </label>
            <div class="card-actions">
              <button type="submit" class="btn btn-primary">Công bố kết quả</button>
            </div>
          </form>
        <% } else { %>
          <p><strong>Chưa thể công bố kết quả vì:</strong></p>
          <ul class="field-hint">
            <% (publishResultsStatus && publishResultsStatus.blockers || ['Chưa đủ điều kiện.']).forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
          <div class="card-actions">
            <a href="/teacher/exams/<%= exam.id %>/attempts" class="btn btn-secondary">Xem lượt làm / chấm bài</a>
            <a href="/teacher/incidents?examId=<%= exam.id %>" class="btn btn-secondary">Xử lý sự cố</a>
          </div>
        <% } %>
      </div>
    <% } else if (exam.da_cong_bo_ket_qua) { %>
      <div class="card">
        <p class="field-hint">Đã công bố kết quả lúc <%= formatDateTimeVN(exam.thoi_gian_cong_bo_ket_qua) %>. Học sinh có thể xem điểm trong mục Kết quả.</p>
      </div>
    <% } %>

    <div class="exam-stack">
      <% if (examQuestions.length === 0) { %>
        <div class="card exam-panel">
          <h2 class="section-title">Câu hỏi trong đề</h2>
          <div class="empty-state empty-state-inline">
            <p>Đề thi chưa có câu hỏi nào.</p>
          </div>
        </div>
      <% } else if (isEditable) { %>
        <div class="card exam-panel">
          <form action="/teacher/exams/<%= exam.id %>/questions/scores" method="POST" class="form exam-scores-form" id="exam-scores-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="card-header-row">
              <div>
                <h2 class="section-title">Câu hỏi trong đề</h2>
                <p class="field-hint"><%= examQuestions.length %> câu · tổng <%= Number(exam.tong_diem).toFixed(2) %> điểm</p>
              </div>
              <button type="submit" class="btn btn-primary">Lưu điểm</button>
            </div>
            <div class="table-wrap">
              <table class="table-questions">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Nội dung</th>
                    <th>Loại</th>
                    <th>Điểm</th>
                    <th class="col-actions">Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  <% examQuestions.forEach(function(eq) { %>
                    <tr>
                      <td><%= eq.thu_tu_goc %></td>
                      <td class="question-cell">
                        <div class="question-cell-preview"><%= questionListPreview(eq.noi_dung) %></div>
                      </td>
                      <td><span class="badge badge-muted"><%= typeLabels[eq.loai_cau_hoi] %></span></td>
                      <td>
                        <input
                          type="number"
                          name="diemCauHoi_<%= eq.cau_hoi_id %>"
                          id="diem-cau-hoi-<%= eq.cau_hoi_id %>"
                          step="0.25"
                          min="0.25"
                          value="<%= eq.diem %>"
                          class="score-input"
                          required
                          aria-label="Điểm câu <%= eq.thu_tu_goc %>"
                        >
                      </td>
                      <td class="table-actions">
                        <button
                          type="submit"
                          class="btn btn-danger btn-sm"
                          form="exam-remove-question-<%= eq.cau_hoi_id %>"
                        >Xóa</button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="exam-panel-footer">
              <button type="submit" class="btn btn-primary">Lưu điểm</button>
            </div>
          </form>
        </div>
        <% examQuestions.forEach(function(eq) { %>
          <form
            id="exam-remove-question-<%= eq.cau_hoi_id %>"
            action="/teacher/exams/<%= exam.id %>/questions/<%= eq.cau_hoi_id %>?_method=DELETE"
            method="POST"
            class="sr-only"
            aria-hidden="true"
            data-confirm="Xóa câu hỏi này khỏi đề?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm" tabindex="-1">Xóa</button>
          </form>
        <% }); %>
      <% } else { %>
        <div class="card exam-panel">
          <div class="card-header-row">
            <div>
              <h2 class="section-title">Câu hỏi trong đề</h2>
              <p class="field-hint"><%= examQuestions.length %> câu · tổng <%= Number(exam.tong_diem).toFixed(2) %> điểm</p>
            </div>
          </div>
          <div class="table-wrap">
            <table class="table-questions">
              <thead>
                <tr>
                  <th>STT</th>
                  <th>Nội dung</th>
                  <th>Loại</th>
                  <th>Điểm</th>
                </tr>
              </thead>
              <tbody>
                <% examQuestions.forEach(function(eq) { %>
                  <tr>
                    <td><%= eq.thu_tu_goc %></td>
                    <td class="question-cell">
                      <div class="question-cell-preview"><%= questionListPreview(eq.noi_dung) %></div>
                    </td>
                    <td><span class="badge badge-muted"><%= typeLabels[eq.loai_cau_hoi] %></span></td>
                    <td><%= Number(eq.diem).toFixed(2) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <% if (isEditable) { %>
        <div class="card exam-panel">
          <div class="card-header-row">
            <h2 class="section-title">Thêm câu hỏi vào đề</h2>
            <span class="field-hint" id="picker-count" aria-live="polite">Đã chọn 0</span>
          </div>
          <% if (availableQuestions.length === 0) { %>
            <div class="empty-state empty-state-inline">
              <p>Không còn câu hỏi nào trong ngân hàng để thêm. <a href="/teacher/questions/create">Tạo câu hỏi mới</a>.</p>
            </div>
          <% } else { %>
            <form action="/teacher/exams/<%= exam.id %>/questions" method="POST" class="form" id="exam-add-questions-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="question-picker-toolbar">
                <label class="checkbox-label">
                  <input type="checkbox" id="picker-select-all"> Chọn tất cả (<span data-picker-visible-count><%= availableQuestions.length %></span>)
                </label>
                <div class="form-group picker-filter">
                  <label for="picker-khoi-lop">Lọc lớp</label>
                  <select id="picker-khoi-lop">
                    <option value="">Tất cả</option>
                  <% for (let k = 1; k <= 12; k += 1) { %>
                    <option value="<%= k %>">Lớp <%= k %></option>
                  <% } %>
                  </select>
                </div>
              </div>
              <div class="table-wrap question-picker">
                <table>
                  <thead>
                    <tr>
                      <th style="width:2.5rem"></th>
                      <th>Loại</th>
                      <th>Lớp</th>
                      <th>Nội dung</th>
                      <th style="width:6rem">Điểm</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% availableQuestions.forEach(function(q) { %>
                      <tr data-khoi-lop="<%= q.khoi_lop || '' %>">
                        <td>
                          <input type="checkbox" class="picker-check" name="cauHoiIds" value="<%= q.id %>" aria-label="Chọn câu hỏi <%= q.id %>">
                        </td>
                        <td><span class="badge badge-muted"><%= typeLabels[q.loai_cau_hoi] %></span></td>
                        <td><%= q.khoi_lop ? ('Lớp ' + q.khoi_lop) : '—' %></td>
                        <td><span class="question-preview"><%= q.noi_dung.slice(0, 120) %><%= q.noi_dung.length > 120 ? '…' : '' %></span></td>
                        <td>
                          <input
                            type="number"
                            class="score-input picker-score"
                            name="diemCauHoi_<%= q.id %>"
                            value="<%= q.diem_mac_dinh %>"
                            step="0.25"
                            min="0.25"
                            readonly
                            aria-label="Điểm câu <%= q.id %>"
                          >
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <div class="exam-panel-footer">
                <p class="field-hint">Chọn câu rồi thêm vào đề.</p>
                <button type="submit" class="btn btn-primary">Thêm các câu đã chọn</button>
              </div>
            </form>
            <script src="/js/exam-question-picker.js" defer></script>
          <% } %>
        </div>
      <% } %>

      <div class="card exam-panel">
        <div class="card-header-row">
          <div>
            <h2 class="section-title">Lớp được giao</h2>
            <p class="field-hint">
              <%= assignedClasses.length > 0
                ? (assignedClasses.length + ' lớp đang được giao đề này')
                : 'Chưa giao cho lớp nào' %>
            </p>
          </div>
        </div>

        <% if (assignedClasses.length === 0) { %>
          <div class="empty-state empty-state-inline">
            <p>Đề thi chưa được giao cho lớp nào.</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tên lớp</th>
                  <th>Mã lớp</th>
                  <th>Ngày giao</th>
                  <% if (exam.trang_thai !== 'DA_HUY') { %><th class="col-actions">Thao tác</th><% } %>
                </tr>
              </thead>
              <tbody>
                <% assignedClasses.forEach(function(cls) { %>
                  <tr>
                    <td><%= cls.ten_lop %></td>
                    <td><span class="class-code"><%= cls.ma_lop %></span></td>
                    <td><%= formatDateTimeVN(cls.created_at) %></td>
                    <% if (exam.trang_thai !== 'DA_HUY') { %>
                      <td class="table-actions">
                        <form action="/teacher/exams/<%= exam.id %>/unassign" method="POST" class="inline-form" data-confirm="Hủy giao đề cho lớp <%= cls.ten_lop %>?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="lopHocId" value="<%= cls.lop_hoc_id %>">
                          <button type="submit" class="btn btn-danger btn-sm">Hủy giao</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (exam.trang_thai !== 'DA_HUY') { %>
          <div class="exam-panel-footer exam-assign-footer">
            <div class="exam-assign-copy">
              <h3 class="exam-assign-title">Giao đề cho lớp</h3>
              <% if (availableClasses.length === 0) { %>
                <% if (assignedClasses.length > 0) { %>
                  <p class="field-hint">Đã giao đủ các lớp đang hoạt động. Muốn giao lớp khác thì <a href="/teacher/classes/create">tạo lớp mới</a>, hoặc dùng <strong>Hủy giao</strong> rồi giao lại.</p>
                <% } else { %>
                  <p class="field-hint">Chưa có lớp hoạt động để giao. <a href="/teacher/classes/create">Tạo lớp mới</a>.</p>
                <% } %>
              <% } else { %>
                <p class="field-hint">Chọn lớp để học sinh trong lớp có thể làm đề này.</p>
              <% } %>
            </div>
            <% if (availableClasses.length > 0) { %>
              <form action="/teacher/exams/<%= exam.id %>/assign" method="POST" class="exam-assign-form" data-confirm="Giao đề này cho lớp đã chọn?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                  <label for="lopHocId">Lớp học</label>
                  <select id="lopHocId" name="lopHocId" required>
                    <% availableClasses.forEach(function(cls) { %>
                      <option value="<%= cls.id %>"><%= cls.ten_lop %> (<%= cls.ma_lop %>)</option>
                    <% }); %>
                  </select>
                </div>
                <button type="submit" class="btn btn-primary">Giao đề</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/katex-assets') %>
<%- include('../../partials/app-end') %>
<%- include('../../partials/footer') %>
