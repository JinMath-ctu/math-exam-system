<%- include('../../partials/header') %>
<%- include('../../partials/navbar-teacher') %>
<main id="main-content" class="page-list">
  <div class="container">
    <%- include('../../partials/flash') %>

    <header class="page-header">
      <h1>Lớp học</h1>
      <p class="page-lead">Quản lý các lớp học, mã lớp và thành viên.</p>
    </header>

    <div class="toolbar">
      <form action="/teacher/classes" method="GET" class="filter-form">
        <div class="form-group">
          <label for="q">Tìm kiếm</label>
          <input type="text" id="q" name="q" value="<%= filters.q %>" placeholder="Tên lớp hoặc mã lớp">
        </div>
        <div class="form-group">
          <label for="trangThai">Trạng thái</label>
          <select id="trangThai" name="trangThai">
            <option value="" <%= filters.trangThai === '' ? 'selected' : '' %>>Tất cả</option>
            <option value="HOAT_DONG" <%= filters.trangThai === 'HOAT_DONG' ? 'selected' : '' %>>Hoạt động</option>
            <option value="LUU_TRU" <%= filters.trangThai === 'LUU_TRU' ? 'selected' : '' %>>Lưu trữ</option>
          </select>
        </div>
        <button type="submit" class="btn btn-secondary">Lọc</button>
      </form>
      <a href="/teacher/classes/create" class="btn btn-primary">+ Tạo lớp mới</a>
    </div>

    <% if (classes.length === 0) { %>
      <div class="card empty-state">
        <p>Chưa có lớp học nào phù hợp. Hãy tạo lớp học đầu tiên của bạn.</p>
        <a href="/teacher/classes/create" class="btn btn-primary">+ Tạo lớp mới</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tên lớp</th>
              <th>Mã lớp</th>
              <th>Số học sinh</th>
              <th>Trạng thái</th>
              <th>Ngày tạo</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% classes.forEach(function(cls) { %>
              <tr>
                <td><a href="/teacher/classes/<%= cls.id %>"><%= cls.ten_lop %></a></td>
                <td><span class="class-code"><%= cls.ma_lop %></span></td>
                <td><%= cls.so_thanh_vien %></td>
                <td>
                  <% if (cls.trang_thai === 'HOAT_DONG') { %>
                    <span class="badge badge-success">Hoạt động</span>
                  <% } else { %>
                    <span class="badge badge-archived">Lưu trữ</span>
                  <% } %>
                </td>
                <td><%= new Date(cls.created_at).toLocaleDateString('vi-VN') %></td>
                <td class="table-actions">
                  <a href="/teacher/classes/<%= cls.id %>" class="btn btn-secondary btn-sm">Xem</a>
                  <a href="/teacher/classes/<%= cls.id %>/edit" class="btn btn-secondary btn-sm">Sửa</a>
                  <% if (Number(cls.so_luot_lam) === 0) { %>
                    <form action="/teacher/classes/<%= cls.id %>/delete" method="POST" class="inline-form" data-confirm="Xóa vĩnh viễn lớp này? Không thể hoàn tác.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
<%- include('../../partials/app-end') %>
<%- include('../../partials/footer') %>
