<%- include('../partials/header', { bodyClass: 'is-auth' }) %>
<main id="main-content" class="page-auth">
  <div class="auth-decor" aria-hidden="true">
    <span class="d1">π</span>
    <span class="d2">∑</span>
    <span class="d3">√</span>
    <span class="d4">Δ</span>
  </div>

  <div class="auth-shell">
    <div class="auth-card">
      <div class="auth-card-logo">
        <a href="/" aria-label="JinMath - Trang chủ">
          <img src="/images/jinmath-logo.png" alt="JinMath" width="180" height="52">
        </a>
      </div>

      <h1>Quên mật khẩu</h1>
      <p class="auth-subtitle">Nhập email để nhận mã xác nhận.</p>

      <%- include('../partials/flash') %>

      <form action="/auth/forgot-password" method="POST" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= (formData && formData.email) ? formData.email : '' %>"
            required
            autocomplete="email"
            placeholder="ten@example.com"
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block">Gửi mã</button>
      </form>

      <p class="auth-footer">
        <a href="/auth/login">Quay lại đăng nhập</a>
      </p>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
