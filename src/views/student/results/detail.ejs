<%
const typeLabels = { MOT_DAP_AN: 'Một đáp án', DUNG_SAI: 'Đúng/Sai', TRA_LOI_NGAN: 'Trả lời ngắn', TU_LUAN: 'Tự luận' };
%>
<%- include('../../partials/header') %>
<%- include('../../partials/navbar-student') %>
<main id="main-content" class="page-list">
  <div class="container">
    <p><a href="/student/results">&larr; Kết quả của tôi</a></p>

    <%- include('../../partials/flash') %>

    <header class="page-header">
      <h1><%= attempt.ten_de %></h1>
      <p class="page-lead">Lần làm <%= attempt.lan_thu %> — công bố lúc <%= formatDateTimeVN(attempt.thoi_gian_cong_bo_ket_qua) %></p>
    </header>

    <div class="score-hero">
      <div>
        <div class="stat-label">Tổng điểm</div>
        <div class="score-hero-value">
          <%= Number(attempt.tong_diem).toFixed(2) %>
          <span>/ <%= Number(attempt.de_tong_diem).toFixed(2) %></span>
        </div>
      </div>
      <div class="detail-grid score-hero-meta">
        <div class="detail-item">
          <span class="detail-label">Điểm tự động</span>
          <span class="detail-value"><%= Number(attempt.diem_tu_dong).toFixed(2) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Điểm tự luận</span>
          <span class="detail-value"><%= Number(attempt.diem_tu_luan).toFixed(2) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Nộp lúc</span>
          <span class="detail-value"><%= attempt.thoi_gian_nop ? formatDateTimeVN(attempt.thoi_gian_nop) : '—' %></span>
        </div>
      </div>
    </div>
    <% if (!choXemDapAn) { %>
      <p class="field-hint">Giáo viên chưa cho phép xem đáp án chi tiết của đề này — chỉ hiển thị điểm từng câu.</p>
    <% } %>

    <h2 class="section-title">Chi tiết từng câu</h2>

    <% questions.forEach(function(q, index) { %>
      <div class="review-item <%= q.laDung === true ? 'is-correct' : (q.laDung === false ? 'is-wrong' : '') %>">
        <div class="card-header-row">
          <h3>Câu <%= index + 1 %> <span class="field-hint">(<%= typeLabels[q.loaiCauHoi] %>)</span></h3>
          <span class="badge badge-muted"><%= q.diemDatDuoc.toFixed(2) %> / <%= q.diemToiDa.toFixed(2) %></span>
        </div>

        <div class="katex-content question-content"><%= q.noiDung %></div>

        <% if (choXemDapAn) { %>
          <% if (q.loaiCauHoi === 'MOT_DAP_AN') { %>
            <ul class="answer-view-list">
              <% (q.tuyChon || []).forEach(function(opt, index) { %>
                <li class="<%= opt.la_dap_an_dung ? 'is-correct' : '' %> <%= q.dapAnDaChon && q.dapAnDaChon.id === opt.id ? 'is-selected' : '' %>">
                  <span class="katex-content"><strong><%= String.fromCharCode(65 + index) %>.</strong> <%= opt.noi_dung %></span>
                  <span>
                    <% if (opt.la_dap_an_dung) { %><span class="badge badge-success">Đáp án đúng</span><% } %>
                    <% if (q.dapAnDaChon && q.dapAnDaChon.id === opt.id) { %><span class="badge badge-info">Bạn đã chọn</span><% } %>
                  </span>
                </li>
              <% }); %>
            </ul>
          <% } else if (q.loaiCauHoi === 'DUNG_SAI') { %>
            <ul class="answer-view-list">
              <% (q.tuyChon || []).forEach(function(opt, index) {
                const label = ['a', 'b', 'c', 'd'][index] || (index + 1);
                const selected = q.statementSelections ? q.statementSelections[String(opt.id)] : undefined;
                const selectedLabel = selected === true ? 'Đúng' : (selected === false ? 'Sai' : '(bỏ trống)');
                const keyLabel = opt.la_dap_an_dung ? 'Đúng' : 'Sai';
              %>
                <li>
                  <span class="katex-content"><strong><%= label %>)</strong> <%= opt.noi_dung %></span>
                  <span>
                    <span class="badge badge-muted">Bạn chọn: <%= selectedLabel %></span>
                    <span class="badge badge-success">Đáp án: <%= keyLabel %></span>
                  </span>
                </li>
              <% }); %>
            </ul>
          <% } else if (q.loaiCauHoi === 'TRA_LOI_NGAN') { %>
            <p><strong>Câu trả lời của bạn:</strong> <%= q.noiDungTraLoi || '(bỏ trống)' %></p>
            <p><strong>Đáp án chuẩn:</strong> <%= q.dapAnNganChuan || '—' %></p>
          <% } else { %>
            <div class="answer-block">
              <span class="detail-label">Bài làm của bạn</span>
              <div class="student-answer katex-content"><%= q.noiDungTraLoi || '(bỏ trống)' %></div>
            </div>
          <% } %>

          <% if (q.nhanXet) { %>
            <p><strong>Nhận xét của giáo viên:</strong> <%= q.nhanXet %></p>
          <% } %>

          <% if (q.loiGiai) { %>
            <details class="inline-edit">
              <summary>Xem lời giải</summary>
              <div class="inline-edit-form katex-content"><%= q.loiGiai %></div>
            </details>
          <% } %>
        <% } %>
      </div>
    <% }); %>
  </div>
</main>
<%- include('../../partials/katex-assets') %>
<%- include('../../partials/app-end') %>
<%- include('../../partials/footer') %>
