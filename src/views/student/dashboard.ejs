<%- include('../partials/header') %>
<%- include('../partials/navbar-student') %>
<main id="main-content" class="page-dashboard">
  <div class="container">
    <%- include('../partials/flash') %>

    <header class="page-header">
      <div>
        <h1>Xin chào, <%= user.hoTen %></h1>
        <p class="page-lead">Tham gia lớp, làm bài kiểm tra và xem kết quả sau khi giáo viên công bố.</p>
      </div>
      <div class="page-header-actions">
        <a href="/student/exams" class="btn btn-primary">Xem bài thi</a>
        <a href="/student/classes/join" class="btn btn-secondary">Tham gia lớp</a>
      </div>
    </header>

    <section class="dashboard-grid" aria-label="Lối tắt học sinh">
      <article class="card dashboard-card is-featured">
        <h2>Bài thi đang mở</h2>
        <p>Vào danh sách đề được giao để bắt đầu hoặc tiếp tục bài làm. Hệ thống tự lưu đáp án và khôi phục khi tải lại trang.</p>
        <div class="card-actions">
          <a href="/student/exams" class="btn btn-primary btn-sm">Vào bài thi</a>
        </div>
      </article>

      <article class="card dashboard-card">
        <h2>Lớp học</h2>
        <p>Xem lớp đã tham gia hoặc nhập mã lớp mới.</p>
        <a href="/student/classes" class="btn btn-secondary btn-sm">Xem lớp học</a>
      </article>

      <article class="card dashboard-card">
        <h2>Kết quả</h2>
        <p>Xem điểm và lời giải sau khi giáo viên công bố kết quả.</p>
        <a href="/student/results" class="btn btn-secondary btn-sm">Xem kết quả</a>
      </article>
    </section>
  </div>
</main>
<%- include('../partials/app-end') %>
<%- include('../partials/footer') %>
