<%
const timeStatusLabels = { SAP_MO: 'Chưa mở', DANG_MO: 'Đang mở', DA_DONG: 'Đã đóng' };
const timeStatusBadge = { SAP_MO: 'badge-muted', DANG_MO: 'badge-success', DA_DONG: 'badge-archived' };
function studentAttemptLabel(status, daCongBoKetQua) {
  if (status === 'DA_CHAM') {
    return daCongBoKetQua ? 'Đã chấm' : 'Đang chấm';
  }
  if (status === 'DA_NOP') return 'Đã nộp';
  if (status === 'TU_DONG_NOP') return 'Đã tự động nộp';
  if (status === 'DANG_LAM') return 'Đang làm';
  return status || '';
}
const activeExams = exams.filter(function(row) {
  return !row.het_luot && row.de_trang_thai !== 'DA_HUY';
});
const finishedExams = exams.filter(function(row) {
  return row.het_luot || row.de_trang_thai === 'DA_HUY';
});
%>
<%- include('../../partials/header') %>
<%- include('../../partials/navbar-student') %>
<main id="main-content" class="page-list">
  <div class="container">
    <%- include('../../partials/flash') %>

    <header class="page-header">
      <h1>Bài thi được giao</h1>
      <p class="page-lead">Chỉ hiện các đề bạn còn lượt làm hoặc đang làm dở. Đề đã hết lượt được chuyển xuống cuối trang.</p>
    </header>

    <% if (exams.length === 0) { %>
      <div class="card empty-state">
        <p>Bạn chưa được giao đề thi nào. Hãy tham gia lớp học để nhận đề thi từ giáo viên.</p>
        <a href="/student/classes/join" class="btn btn-primary">+ Tham gia lớp học</a>
      </div>
    <% } else { %>
      <h2 class="section-title">Đề có thể làm</h2>
      <% if (activeExams.length === 0) { %>
        <div class="card empty-state">
          <p>Hiện không còn đề nào bạn có thể bắt đầu làm mới.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tên đề thi</th>
                <th>Lớp</th>
                <th>Thời gian mở đề</th>
                <th>Trạng thái</th>
                <th>Lượt làm</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% activeExams.forEach(function(row) { %>
                <tr>
                  <td><%= row.ten_de %></td>
                  <td><%= row.ten_lop %></td>
                  <td>
                    <%= formatDateTimeVN(row.thoi_gian_bat_dau) %> &rarr; <%= formatDateTimeVN(row.thoi_gian_ket_thuc) %>
                  </td>
                  <td>
                    <span class="badge <%= timeStatusBadge[row.trang_thai_thoi_gian] %>"><%= timeStatusLabels[row.trang_thai_thoi_gian] %></span>
                    <% if (row.dang_lam_id) { %>
                      <span class="badge badge-success">Đang làm dở</span>
                    <% } else if (row.trang_thai_gan_nhat) { %>
                      <span class="badge badge-muted"><%= studentAttemptLabel(row.trang_thai_gan_nhat, row.da_cong_bo_ket_qua) %></span>
                    <% } %>
                  </td>
                  <td><%= row.so_lan_da_lam %> / <%= row.so_lan_duoc_lam %></td>
                  <td>
                    <a href="/student/exams/<%= row.de_thi_id %>" class="btn btn-secondary btn-sm">Xem chi tiết</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <% if (finishedExams.length > 0) { %>
        <section class="exam-list-section exam-list-section-finished">
          <h2 class="section-title">Đề đã hết lượt / đã hủy</h2>
          <p class="field-hint exam-list-section-hint">Các đề này không còn mở để làm mới. Sau khi giáo viên công bố kết quả, hãy xem ở mục Kết quả.</p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tên đề thi</th>
                  <th>Lớp</th>
                  <th>Thời gian mở đề</th>
                  <th>Trạng thái</th>
                  <th>Lượt làm</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% finishedExams.forEach(function(row) { %>
                  <tr>
                    <td><%= row.ten_de %></td>
                    <td><%= row.ten_lop %></td>
                    <td>
                      <%= formatDateTimeVN(row.thoi_gian_bat_dau) %> &rarr; <%= formatDateTimeVN(row.thoi_gian_ket_thuc) %>
                    </td>
                    <td>
                      <% if (row.de_trang_thai === 'DA_HUY') { %>
                        <span class="badge badge-archived">Đã hủy</span>
                      <% } else { %>
                        <span class="badge badge-archived">Hết lượt làm</span>
                      <% } %>
                      <% if (row.trang_thai_gan_nhat) { %>
                        <span class="badge badge-muted"><%= studentAttemptLabel(row.trang_thai_gan_nhat, row.da_cong_bo_ket_qua) %></span>
                      <% } %>
                    </td>
                    <td><%= row.so_lan_da_lam %> / <%= row.so_lan_duoc_lam %></td>
                    <td>
                      <a href="/student/exams/<%= row.de_thi_id %>" class="btn btn-secondary btn-sm">Xem chi tiết</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>
    <% } %>
  </div>
</main>
<%- include('../../partials/app-end') %>
<%- include('../../partials/footer') %>
