NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=web_kiem_tra_toan
DB_TIMEZONE=+07:00
SESSION_SECRET=

# Gửi mã OTP quên mật khẩu
# Khuyến nghị trên Railway: Brevo HTTPS API (ổn định hơn SMTP)
#   Brevo → SMTP & API → tab "API keys & MCP" → Generate API key (dạng xkeysib-...)
#   BREVO_API_KEY=xkeysib-...
#   MAIL_FROM="JinMath <email_da_xac_minh_tren_Brevo@gmail.com>"
# Nếu bật chặn IP trên Brevo: cho phép IP Railway hoặc tắt hạn chế IP cho key.
#
# SMTP (local / khi cloud không chặn outbound 587):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=...@smtp-brevo.com
#   SMTP_PASS=xsmtpsib-...   (SMTP key — khác API key)
# Nếu SMTP_PASS/RESEND_API_KEY bắt đầu bằng re_ → dùng Resend HTTPS API.
# Nếu bỏ trống khi NODE_ENV != production: mã in ra console (demo).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
