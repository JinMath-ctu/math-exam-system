NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=web_kiem_tra_toan
DB_TIMEZONE=+07:00
SESSION_SECRET=

# Cấu hình SMTP để gửi mã xác nhận quên mật khẩu
# Gmail bắt buộc dùng App Password, không dùng mật khẩu đăng nhập Gmail.
# Nếu bỏ trống SMTP khi NODE_ENV != production: mã sẽ in ra console máy chủ (phục vụ demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
